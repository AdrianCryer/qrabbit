{
  "name": "@qrabbit/cloud-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Keeps a collection folder in step with Qrabbit Cloud: scan, pull, merge by file format, push. Node only, no Electron.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qrabbit/cloud-api": "workspace:*",
    "@qrabbit/shared": "workspace:*",
    "@qrabbit/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
