{
  "name": "@qrabbit/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Qrabbit desktop app: read, highlight, explore in branches, keep what you learned.",
  "author": "Adrian Cryer",
  "repository": { "type": "git", "url": "https://github.com/AdrianCryer/qrabbit.git", "directory": "apps/desktop" },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --dir src/renderer/src",
    "pack": "node scripts/fetch-node.mjs && electron-vite build && electron-builder --dir",
    "dist": "node scripts/fetch-node.mjs && electron-vite build && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.2",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "1.5.0",
    "@mozilla/readability": "^0.6.0",
    "@qrabbit/acp-client": "workspace:*",
    "@qrabbit/cloud-api": "workspace:*",
    "@qrabbit/cloud-sync": "workspace:*",
    "@qrabbit/shared": "workspace:*",
    "@qrabbit/workspace": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.16.22",
    "pdfjs-dist": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  }
}
