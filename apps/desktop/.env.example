# QRabbit Cloud: the Supabase project the app talks to, by URL and publishable key. Neither is a secret, but
# both belong to one deployment, so they stay out of the source. Copy this file to .env.production.local for
# release builds and to .env.development.local for `pnpm desktop:dev` (both ignored by git), or set the same
# names in the environment, which wins. For the local stack, use the API_URL and PUBLISHABLE_KEY that
# `pnpm cloud:status` prints.
QRABBIT_CLOUD_URL=
QRABBIT_CLOUD_PUBLISHABLE_KEY=
