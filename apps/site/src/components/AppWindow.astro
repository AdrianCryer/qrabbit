---
/**
 * An app capture framed as the real window, as on the README images (tools/dev/stage-page.mjs):
 * Windows 11 corners, a hairline border, a soft shadow, and the caption buttons that a page
 * capture leaves out. The buttons are sized against the app's 1280-pixel layout, so they match
 * the header at any width.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` attribute: how wide the window is drawn at each breakpoint. */
  sizes: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, sizes, class: className, eager = false } = Astro.props;
---

<div class:list={["appwin", className]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1920, 2560]}
    sizes={sizes}
    format="webp"
    quality={86}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
  <div class="caption" aria-hidden="true">
    <span><svg viewBox="0 0 10 10"><path d="M0 5.5h10"></path></svg></span>
    <span><svg viewBox="0 0 10 10"><rect x="0.5" y="0.5" width="9" height="9"></rect></svg></span>
    <span><svg viewBox="0 0 10 10" class="x"><path d="M0 0l10 10M10 0L0 10"></path></svg></span>
  </div>
</div>

<style>
  .appwin {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1280 / 800;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: var(--shadow-win);
  }
  .appwin img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .caption { position: absolute; top: 0; right: 0; height: calc(100cqi * 44 / 1280); display: flex; }
  .caption span { width: calc(100cqi * 46 / 1280); height: 100%; display: grid; place-items: center; }
  .caption svg { width: calc(100cqi * 10 / 1280); height: calc(100cqi * 10 / 1280); stroke: #a3a8b0; stroke-width: 1; fill: none; shape-rendering: crispEdges; overflow: visible; }
  .caption svg.x { shape-rendering: geometricPrecision; }
</style>
