---
/**
 * The site's white rabbit, drawn in the theme's neutrals with the one accent for the inner ears.
 *   sit   sitting, facing right
 *   peek  head and paws over an edge; the edge is the bottom of the drawing, at y = 120 of 132
 *   hole  sitting beside a burrow; once the scene gains `.in` it hops in and peeks back out
 *   mark  the Q tile with ears, for the header and footer
 * `at` draws the pose as a group inside another drawing, moved by that SVG transform.
 */
interface Props {
  pose: "sit" | "peek" | "hole" | "mark";
  class?: string;
  title?: string;
  at?: string;
}
const { pose, class: className, title, at } = Astro.props;
// Gradient and clip ids must be unique per drawing on the page.
const id = `r${Math.random().toString(36).slice(2, 8)}`;
const box = { sit: "0 0 200 200", peek: "0 0 160 132", hole: "50 0 500 236", mark: "0 0 32 42" }[pose];
const a11y = title ? { role: "img" as const, "aria-label": title } : { "aria-hidden": "true" as const };
const Wrap = at ? "g" : "svg";
const attrs = at ? { transform: at } : { viewBox: box, ...a11y };
---

<Wrap class:list={["rabbit", pose, className]} {...attrs}>
  {
    pose === "sit" && (
      <Fragment>
        <defs>
          <linearGradient id={`${id}f`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f6f7f9" />
            <stop offset="1" stop-color="#c3c8cf" />
          </linearGradient>
        </defs>
        <ellipse cx="102" cy="191" rx="76" ry="6" fill="#000" opacity="0.4" />
        <g class="ear back">
          <ellipse cx="114" cy="50" rx="11" ry="37" transform="rotate(-24 114 84)" fill="#b7bcc4" />
        </g>
        <ellipse cx="84" cy="138" rx="58" ry="48" fill={`url(#${id}f)`} />
        <ellipse cx="124" cy="141" rx="33" ry="43" fill={`url(#${id}f)`} />
        <circle cx="30" cy="126" r="14" fill="#fbfbfc" />
        <ellipse cx="139" cy="89" rx="37" ry="31" transform="rotate(12 139 89)" fill="#eef0f3" />
        <ellipse cx="164" cy="100" rx="16" ry="13.5" fill="#eceef1" />
        <ellipse cx="146" cy="108" rx="16" ry="10" fill="#e6e9ec" />
        <g class="ear front">
          <ellipse cx="132" cy="44" rx="12.5" ry="40" transform="rotate(-9 132 82)" fill="#f1f3f5" />
          <ellipse cx="133" cy="47" rx="5.8" ry="30" transform="rotate(-9 132 82)" fill="#c9f24d" opacity="0.72" />
        </g>
        <ellipse cx="94" cy="184" rx="42" ry="8.5" fill="#d6dadf" />
        <ellipse cx="146" cy="183.5" rx="14" ry="7" fill="#e3e6e9" />
        <g class="eye">
          <circle cx="153" cy="83" r="4.8" fill="#15181c" />
          <circle cx="154.8" cy="81.2" r="1.6" fill="#fff" />
        </g>
        <ellipse cx="177.5" cy="97" rx="3.4" ry="2.7" fill="#4a5058" />
        <path d="M169 104.5 l23 -3.5 M169 107.5 l22 4" stroke="#8a9099" stroke-width="1.1" stroke-linecap="round" fill="none" />
      </Fragment>
    )
  }

  {
    pose === "peek" && (
      <Fragment>
        <defs>
          <clipPath id={`${id}c`}>
            <rect x="0" y="0" width="160" height="120" />
          </clipPath>
          <linearGradient id={`${id}f`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f6f7f9" />
            <stop offset="1" stop-color="#d4d8dd" />
          </linearGradient>
        </defs>
        <g clip-path={`url(#${id}c)`}>
          <g class="ear left">
            <ellipse cx="58" cy="50" rx="13" ry="40" transform="rotate(-13 58 90)" fill="#eef0f3" />
            <ellipse cx="58" cy="53" rx="6" ry="30" transform="rotate(-13 58 90)" fill="#c9f24d" opacity="0.72" />
          </g>
          <g class="ear right">
            <path d="M92 90 C 90 62, 92 34, 104 20 C 112 11, 126 10, 131 18 C 124 20, 118 26, 116 36 C 113 54, 114 72, 116 90 Z" fill="#e7eaee" />
            <path d="M99 86 C 98 64, 100 42, 107 30 C 110 25, 114 22, 118 21 C 112 30, 109 44, 108 60 C 107 70, 108 78, 109 86 Z" fill="#c9f24d" opacity="0.66" />
          </g>
          <ellipse cx="80" cy="128" rx="52" ry="46" fill={`url(#${id}f)`} />
          <g class="eye">
            <circle cx="61" cy="108" r="5.2" fill="#15181c" />
            <circle cx="99" cy="108" r="5.2" fill="#15181c" />
            <circle cx="63" cy="106" r="1.7" fill="#fff" />
            <circle cx="101" cy="106" r="1.7" fill="#fff" />
          </g>
          <path d="M76 117 q4 3.4 8 0" fill="#4a5058" />
        </g>
        <g class="paws">
          <ellipse cx="44" cy="121" rx="15" ry="8" fill="#f1f3f5" />
          <ellipse cx="116" cy="121" rx="15" ry="8" fill="#f1f3f5" />
          <path d="M40 116.2v5.2 M46.5 115.8v5.2 M112.5 115.8v5.2 M119 116.2v5.2" stroke="#b7bcc4" stroke-width="1.2" stroke-linecap="round" />
        </g>
      </Fragment>
    )
  }

  {
    pose === "hole" && (
      <Fragment>
        <defs>
          {/* Above the burrow's front rim: the rabbit vanishes below it on the way in. The hop
              arcs above the drawing, which shows because .rabbit overflows. */}
          <clipPath id={`${id}a`}>
            <rect x="0" y="-200" width="600" height="414" />
          </clipPath>
          {/* On the way out the paws come to rest on the rim, so they may overlap it. */}
          <clipPath id={`${id}b`}>
            <rect x="0" y="-200" width="600" height="426" />
          </clipPath>
          <radialGradient id={`${id}h`} cx="0.5" cy="0.3" r="0.7">
            <stop offset="0" stop-color="#000" />
            <stop offset="1" stop-color="#08090b" />
          </radialGradient>
        </defs>
        <ellipse cx="300" cy="200" rx="98" ry="26" fill="#1a1d22" />
        <ellipse cx="300" cy="197" rx="76" ry="17" fill={`url(#${id}h)`} />
        <g clip-path={`url(#${id}a)`}>
          <g class="hopper">
            <Astro.self pose="sit" at="translate(52 4)" />
          </g>
        </g>
        <path d="M224 197 a76 17 0 0 0 152 0" fill="none" stroke="#2a2f36" stroke-width="3" />
        <g clip-path={`url(#${id}b)`}>
          <g class="popper">
            <Astro.self pose="peek" at="translate(220 94)" />
          </g>
        </g>
      </Fragment>
    )
  }

  {
    pose === "mark" && (
      <Fragment>
        <g class="ear left">
          <rect x="6" y="0" width="7.5" height="18" rx="3.75" transform="rotate(-12 9.75 16)" fill="#c9f24d" />
          <rect x="8.25" y="3" width="3" height="11" rx="1.5" transform="rotate(-12 9.75 16)" fill="#101407" opacity="0.2" />
        </g>
        <g class="ear right">
          <rect x="18.5" y="0" width="7.5" height="18" rx="3.75" transform="rotate(12 22.25 16)" fill="#c9f24d" />
          <rect x="20.75" y="3" width="3" height="11" rx="1.5" transform="rotate(12 22.25 16)" fill="#101407" opacity="0.2" />
        </g>
        <rect x="0" y="10" width="32" height="32" rx="8" fill="#c9f24d" />
        <text x="16" y="27" text-anchor="middle" dominant-baseline="central" font-family="Inter Variable, Inter, Segoe UI, system-ui, sans-serif" font-weight="750" font-size="22" fill="#101407">Q</text>
      </Fragment>
    )
  }
</Wrap>

<style>
  .rabbit { overflow: visible; }
  /* Blinks now and then; an ear twitches on hover. */
  .eye { transform-box: fill-box; transform-origin: center; animation: blink 6s infinite; }
  .peek .eye { animation-delay: 1.4s; }
  .ear { transform-box: fill-box; transform-origin: 50% 100%; transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .rabbit:hover .ear.front, .rabbit:hover .ear.right { transform: rotate(-9deg); }
  .rabbit:hover .ear.left { transform: rotate(6deg); }
  .mark .ear { transform-origin: 50% 90%; }
  .mark:hover .ear.left { transform: rotate(-10deg); }
  .mark:hover .ear.right { transform: rotate(10deg); }

  /* The burrow: nothing moves until an ancestor gains .in (the page's reveal observer), and
     without scripts the rabbit simply sits beside the hole. */
  .hole .hopper { transform-box: fill-box; transform-origin: 50% 100%; animation: hop-in 1.25s 0.5s both paused; }
  .hole .popper { transform-box: fill-box; transform-origin: 50% 100%; animation: pop-out 0.9s 2.6s both paused; }
  :global(.in) .hole .hopper, :global(.in) .hole .popper { animation-play-state: running; }
  @keyframes hop-in {
    0% { transform: translate(0, 0) scale(1); }
    14% { transform: translate(0, 4px) scale(1.04, 0.92); animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1); }
    52% { transform: translate(84px, -70px) scale(0.9); animation-timing-function: cubic-bezier(0.5, 0, 0.8, 0.4); }
    78% { transform: translate(150px, 10px) scale(0.72); }
    100% { transform: translate(158px, 170px) scale(0.62); }
  }
  @keyframes pop-out {
    0% { transform: translateY(150px); }
    70% { transform: translateY(-6px); }
    100% { transform: translateY(0); }
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eye { animation: none; }
    .ear { transition: none; }
    .hole .hopper { animation: none; }
    .hole .popper { display: none; }
  }
</style>
