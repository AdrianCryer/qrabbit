---
import { downloads, site, type Platform } from "../site";
import GitHubMark from "./GitHubMark.astro";

const icons: Record<Platform, string> = {
  windows: "M3 5.5l7.5-1v7H3zM12 4.2L21 3v8.5h-9zM3 12.5h7.5v7L3 18.5zM12 12.5h9V21l-9-1.2z",
  mac: "M16.5 12.6c0-2.5 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.8 1.2 1.8 2.6 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.4-.9-2.4-3.7zM14.1 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4z",
  linux: "M12 3c-2 0-3.2 1.7-3.2 4 0 1.4.4 2.3.1 3.3-.4 1.3-2.4 3.1-2.9 5.3-.4 1.7.1 3 1.2 3.4.9.3 1.6-.5 2.3-.2.8.3 1.6.9 2.5.9s1.7-.6 2.5-.9c.7-.3 1.4.5 2.3.2 1.1-.4 1.6-1.7 1.2-3.4-.5-2.2-2.5-4-2.9-5.3-.3-1 .1-1.9.1-3.3 0-2.3-1.2-4-3.2-4z",
};
const order: Platform[] = ["windows", "mac", "linux"];
---

<section class="section" id="download">
  <div class="wrap">
    <div class="head reveal">
      <p class="label accent">Download</p>
      <h2 class="h2">Pick something hard to read. <em>Start there.</em></h2>
      <p class="lede">
        Qrabbit is in early access, free and open source. To power the agent you'll need a Claude plan that includes Claude Code, or
        a ChatGPT plan that includes Codex; you sign in from inside the app.
      </p>
    </div>

    <div class="platforms">
      {
        order.map((p) => {
          const d = downloads[p];
          // A build that isn't out yet is a plain card, not a link.
          const Card = d.soon ? "div" : "a";
          return (
            <Card class={`platform reveal${d.soon ? " soon" : ""}`} href={d.soon ? undefined : d.href} data-platform={p}>
              <span class="mine chip accent">Your system</span>
              <svg class:list={["logo", p]} viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[p]} />
              </svg>
              <span class="name">{d.name}</span>
              <span class="meta">{d.runs}</span>
              <span class="meta">{d.formats}</span>
              {d.soon ? (
                <span class="go">Coming soon</span>
              ) : (
                <span class="go">
                  Download
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" />
                  </svg>
                </span>
              )}
            </Card>
          );
        })
      }
    </div>

    <ul class="needs reveal">
      <li><b>Needs</b> a Claude Pro or Max plan for Claude Code, or a ChatGPT Plus or Pro plan for Codex.</li>
      <li><b>Keeps</b> your collections in folders you choose, on your own disk.</li>
      <li><b>Updates</b> arrive as new releases while Qrabbit is in early access.</li>
    </ul>

    <a class="source reveal" href={site.repo}>
      <GitHubMark class="mark" />
      <span><b>Open source</b> under Apache-2.0. Read the code, or build it yourself, on GitHub.</span>
      <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m0 0l-5.5-5.5M19 12l-5.5 5.5" /></svg>
    </a>
  </div>
</section>

<script>
  const ua = navigator.userAgent;
  const mine = /Windows/.test(ua) ? "windows" : /Macintosh|Mac OS X/.test(ua) && !/iPhone|iPad/.test(ua) ? "mac" : /Linux/.test(ua) && !/Android/.test(ua) ? "linux" : null;
  if (mine) document.querySelector(`[data-platform="${mine}"]`)?.classList.add("is-mine");
</script>

<style>
  .platforms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .platform {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 4px;
    padding: 26px 24px 22px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--raised) 0%, #15171b 100%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    transition: border-color 0.25s, transform 0.25s var(--ease), background 0.25s;
  }
  .platform:hover { border-color: var(--accent-line); transform: translateY(-3px); }
  .platform:nth-child(2) { transition-delay: 0.06s; }
  .platform:nth-child(3) { transition-delay: 0.12s; }
  .platform.reveal.in { transition-delay: 0s; }
  .logo { width: 30px; height: 30px; fill: var(--text); margin-bottom: 14px; }
  .logo.linux { fill: none; stroke: var(--text); stroke-width: 1.6; stroke-linejoin: round; }
  .name { font-size: 20px; font-weight: 620; letter-spacing: -0.01em; }
  .meta { color: var(--text-3); font-size: 14px; }
  .go { margin-top: 20px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14.5px; color: var(--text); padding: 9px 14px; border-radius: 10px; background: var(--raised-2); border: 1px solid var(--line-strong); transition: background 0.2s, color 0.2s; }
  .go svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .mine { position: absolute; top: 22px; right: 20px; display: none; font-family: var(--font-ui); font-weight: 500; }
  .platform:global(.is-mine) { border-color: var(--accent-line); background: linear-gradient(180deg, #1b1f18 0%, #15171b 100%); }
  .platform:global(.is-mine) .mine { display: inline-flex; }
  .platform:global(.is-mine) .go, .platform:hover .go { background: var(--accent); color: var(--accent-fg); border-color: transparent; }
  /* Coming soon: nothing to click, so the card stays put and its label stays quiet. */
  .platform.soon:hover { border-color: var(--line); transform: none; }
  .platform.soon .go { color: var(--text-3); background: var(--sunken); border-color: var(--line); }

  .needs { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .needs li { color: var(--text-3); font-size: 14px; line-height: 1.55; padding: 0 4px; }
  .needs b { color: var(--text-2); font-weight: 600; }

  /* The source, in the same quiet register as the fine print above it, one notch brighter because it goes somewhere. */
  .source { margin-top: 36px; display: inline-flex; align-items: center; gap: 14px; padding: 0 4px; color: var(--text-2); font-size: 15px; line-height: 1.5; transition: color 0.2s; }
  .source b { color: var(--text); font-weight: 600; }
  .source .mark { width: 22px; height: 22px; flex: none; fill: var(--text); }
  .source .arrow { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--text-3); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.25s var(--ease), stroke 0.2s; }
  .source:hover { color: var(--text); }
  .source:hover .arrow { stroke: var(--accent); transform: translateX(3px); }

  @media (max-width: 860px) {
    .platforms, .needs { grid-template-columns: minmax(0, 1fr); }
    .source { align-items: start; margin-top: 28px; }
    .source .mark { margin-top: 1px; }
    .source .arrow { display: none; }
  }
</style>
