---
import { site } from "../site";

const faqs = [
  {
    q: "Do I need an API key?",
    a: "No. Qrabbit drives Claude Code or Codex through the Agent Client Protocol, and each signs in with your own Claude or ChatGPT plan in its own flow. Qrabbit never sees a credential.",
  },
  {
    q: "Which subscriptions work?",
    a: "Today, any Claude plan that includes Claude Code (or an Anthropic Console account), and any ChatGPT plan that includes Codex. GitHub Copilot, Gemini through Antigravity, other ACP agents and local models are planned.",
  },
  {
    q: "Where is my work stored?",
    a: "In a plain folder per collection: the sources, one Markdown file per thread, your marks as JSON. Open it in Obsidian or track it with git whenever you like.",
  },
  {
    q: "Does the agent see my comments and bookmarks?",
    a: "No. They're for you, and they never go into a prompt. The agent sees the passage you highlight, the text around it and what you ask.",
  },
  {
    q: "What does Qrabbit Cloud add?",
    a: `Sync and backup of your collections for $${site.cloudPrice} a month, when it launches. The app itself stays free, and your files stay on your disk either way.`,
  },
  {
    q: "What can I read with it?",
    a: "PDFs, Markdown and text files, and web pages, which are saved as clean Markdown so they read like papers and work offline.",
  },
];
---

<section class="section" id="faq">
  <div class="wrap narrow">
    <div class="head reveal">
      <p class="label accent">Questions</p>
      <h2 class="h2">Before you dig in</h2>
    </div>
    <div class="list reveal">
      {
        faqs.map((f) => (
          <details name="faq" data-faq>
            <summary>
              {f.q}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // One answer open at a time, sliding open and shut. Without scripts, `name` makes the browser do
  // the one-at-a-time part itself; with them it goes, because the browser would shut the previous
  // answer instantly the moment the next one opens, before it could slide shut.
  const items = [...document.querySelectorAll<HTMLDetailsElement>("[data-faq]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const running = new Map<HTMLDetailsElement, Animation>();

  /** Slides an answer open or shut, starting from wherever it is now, even mid-slide. */
  function slide(d: HTMLDetailsElement, open: boolean) {
    const body = d.querySelector<HTMLElement>(".answer")!;
    const from = d.open ? body.getBoundingClientRect().height : 0;
    const fromOpacity = d.open ? getComputedStyle(body).opacity : "0";
    running.get(d)?.cancel();
    running.delete(d);
    d.classList.toggle("is-open", open);
    d.open = true;
    if (reduced.matches) {
      d.open = open;
      return;
    }
    const to = open ? body.scrollHeight : 0;
    const anim = body.animate(
      [
        { height: `${from}px`, opacity: fromOpacity },
        { height: `${to}px`, opacity: open ? 1 : 0 },
      ],
      { duration: open ? 420 : 320, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
    );
    running.set(d, anim);
    anim.onfinish = () => {
      running.delete(d);
      if (!open) d.open = false;
    };
  }

  for (const d of items) {
    d.removeAttribute("name");
    d.classList.toggle("is-open", d.open);
    d.querySelector("summary")!.addEventListener("click", (e) => {
      e.preventDefault();
      const open = !d.classList.contains("is-open");
      if (open) for (const other of items) if (other !== d && other.classList.contains("is-open")) slide(other, false);
      slide(d, open);
    });
    // The browser can open an answer by itself, e.g. to show a find-in-page match.
    d.addEventListener("toggle", () => {
      if (running.has(d) || d.open === d.classList.contains("is-open")) return;
      d.classList.toggle("is-open", d.open);
      if (d.open) for (const other of items) if (other !== d && other.classList.contains("is-open")) slide(other, false);
    });
  }
</script>

<style>
  .narrow { max-width: 820px; }
  .list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    font-size: 17.5px;
    font-weight: 560;
    letter-spacing: -0.005em;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { width: 18px; height: 18px; flex: none; stroke: var(--text-3); fill: none; stroke-width: 2; stroke-linecap: round; transition: transform 0.3s var(--ease), stroke 0.2s; }
  summary:hover svg { stroke: var(--text); }
  /* The plus turns as the answer starts to move, not when it finishes shutting. */
  details.is-open summary svg, :global(html:not(.js)) details[open] summary svg { transform: rotate(45deg); stroke: var(--accent); }
  .answer { overflow: hidden; }
  .answer p { color: var(--text-2); font-size: 16px; line-height: 1.65; padding: 0 44px 24px 4px; max-width: 68ch; }
</style>
