---
/**
 * Bring your own subscription: Qrabbit is an Agent Client Protocol client, so any agent that speaks
 * ACP can drive it with its own sign-in. Claude Code and Codex work today; the rest are the plan
 * (planning/plan-v2.md §5.2). Picking one shows what the composer's chips would say.
 */
type Agent = {
  id: string;
  name: string;
  plan: string;
  live?: boolean;
  /** The composer's chips: account, model, and effort where the agent offers it. */
  account: string;
  model: string;
  effort?: string;
  signin: string;
  icon: string;
};

const agents: Agent[] = [
  {
    id: "claude",
    name: "Claude Code",
    plan: "Claude Pro or Max",
    live: true,
    account: "Claude Max",
    model: "Opus",
    effort: "High",
    signin: "Sign in once through Claude Code's own terminal flow, started from the header menu.",
    icon: "M4 17l6-6-6-6M12 19h8",
  },
  {
    id: "codex",
    name: "Codex",
    plan: "ChatGPT Plus or Pro",
    live: true,
    account: "ChatGPT Plus",
    model: "Default",
    effort: "Medium",
    signin: "Sign in with your ChatGPT account in the browser, through Codex's own login, started from the header menu.",
    icon: "M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9z",
  },
  {
    id: "copilot",
    name: "GitHub Copilot",
    plan: "Including Copilot Free",
    account: "Copilot Free",
    model: "Auto",
    signin: "Sign in with GitHub in Copilot's own flow.",
    icon: "M5 12a7 7 0 0 1 14 0v4a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3zM9.5 13v1.5M14.5 13v1.5",
  },
  {
    id: "gemini",
    name: "Gemini",
    plan: "Through Google Antigravity",
    account: "Google AI Pro",
    model: "Default",
    signin: "Sign in with your Google account in Antigravity's own flow.",
    icon: "M12 3c.6 4.8 4.2 8.4 9 9-4.8.6-8.4 4.2-9 9-.6-4.8-4.2-8.4-9-9 4.8-.6 8.4-4.2 9-9z",
  },
  {
    id: "local",
    name: "Local models",
    plan: "Ollama or LM Studio",
    account: "Ollama",
    model: "qwen3",
    signin: "Nothing to sign in to: turns run on your own machine, offline, and cost nothing.",
    icon: "M4 5h16v10H4zM8 19h8M12 15v4",
  },
  {
    id: "acp",
    name: "Any ACP agent",
    plan: "OpenCode, Cursor, Qwen Code, Kiro…",
    account: "OpenCode",
    model: "Default",
    signin: "Whatever the agent offers. Qrabbit only ever talks to it over the protocol.",
    icon: "M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14",
  },
];
const first = agents[0]!;
---

<section class="section" id="agents">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head reveal">
      <p class="label accent">Bring your own subscription</p>
      <h2 class="h2">Use the AI you already pay for. <em>Or run your own.</em></h2>
      <p class="lede">
        Qrabbit doesn't sell AI and never asks for an API key. It drives the coding agent you already have through the
        Agent Client Protocol, so every turn comes out of your existing plan. Claude Code and Codex work today; more
        agents and local models are on the way.
      </p>
    </div>

    <div class="byo reveal">
      <div class="options" role="radiogroup" aria-label="Agent" data-options>
        {
          agents.map((a) => (
            <button
              type="button"
              role="radio"
              class="opt"
              aria-checked={a === first ? "true" : "false"}
              tabindex={a === first ? 0 : -1}
              data-account={a.account}
              data-model={a.model}
              data-effort={a.effort ?? ""}
              data-signin={a.signin}
              data-name={a.name}
              data-live={a.live ? "" : undefined}
              data-icon={a.icon}
            >
              <span class="ico">
                <svg viewBox="0 0 24 24">
                  <path d={a.icon} />
                </svg>
              </span>
              <span class="txt">
                <span class="n">{a.name}</span>
                <span class="p">{a.plan}</span>
              </span>
              <span class:list={["chip", { accent: a.live }]}>{a.live ? "Available now" : "Coming soon"}</span>
            </button>
          ))
        }
      </div>

      <div class="preview" aria-live="polite" data-preview>
        <div class="status">
          <span class="dot" data-dot></span>
          <span data-status>{first.name} · connected</span>
        </div>
        <div class="composer">
          <div class="quote">
            <span class="src">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
              Key Concepts in RL
            </span>
            In deep RL, we deal with parameterized policies: policies whose outputs are computable functions that depend on a set
            of parameters.
          </div>
          <p class="ph">Ask a follow-up, or highlight the paper and choose Ask here</p>
          <div class="chips">
            <span class="c"><svg viewBox="0 0 24 24"><path d={first.icon} data-icon></path></svg><b data-account>{first.account}</b></span>
            <span class="c"><i>model</i><b data-model>{first.model}</b><svg class="chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"></path></svg></span>
            <span class="c" data-effort-chip hidden={!first.effort}><i>effort</i><b data-effort>{first.effort}</b><svg class="chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"></path></svg></span>
            <span class="send"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"></path></svg></span>
          </div>
        </div>
        <p class="signin" data-signin>{first.signin}</p>

        <ol class="flow" aria-label="How a turn reaches your plan">
          <li><b>Qrabbit</b><span>speaks ACP</span></li>
          <li><b>The agent's own app</b><span>signs in its own way</span></li>
          <li><b>Your plan</b><span>pays for the turn</span></li>
        </ol>
        <p class="fine">Qrabbit never reads an agent's tokens, config files or keychain entries.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>("[data-options]")!;
  const options = [...group.querySelectorAll<HTMLButtonElement>(".opt")];
  // The options carry the same data-* names as the preview's slots, so look inside the preview only.
  const preview = document.querySelector<HTMLElement>("[data-preview]")!;
  const $ = <T extends Element = HTMLElement>(sel: string) => preview.querySelector<T>(sel)!;
  const out = {
    icon: $<SVGPathElement>("[data-icon]"),
    account: $("[data-account]"),
    model: $("[data-model]"),
    effort: $("[data-effort]"),
    effortChip: $("[data-effort-chip]"),
    signin: $("[data-signin]"),
    status: $("[data-status]"),
    dot: $("[data-dot]"),
  };

  function pick(opt: HTMLButtonElement, focus = false) {
    for (const o of options) {
      const on = o === opt;
      o.setAttribute("aria-checked", String(on));
      o.tabIndex = on ? 0 : -1;
    }
    if (focus) opt.focus();
    const d = opt.dataset;
    const live = d.live !== undefined;
    out.icon.setAttribute("d", d.icon ?? "");
    out.account.textContent = d.account ?? "";
    out.model.textContent = d.model ?? "";
    out.effort.textContent = d.effort ?? "";
    out.effortChip.hidden = !d.effort;
    out.signin.textContent = d.signin ?? "";
    out.status.textContent = `${d.name} · ${live ? "connected" : "coming soon"}`;
    out.dot.classList.toggle("off", !live);
    // Replay the chips' arrival so the change reads as the composer switching agent.
    const chips = document.querySelector<HTMLElement>(".byo .chips")!;
    chips.classList.remove("swap");
    void chips.offsetWidth;
    chips.classList.add("swap");
  }

  group.addEventListener("click", (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLButtonElement>(".opt");
    if (opt) pick(opt);
  });
  // Radio-group keys: arrows move and select, wrapping at the ends.
  group.addEventListener("keydown", (e) => {
    const i = options.findIndex((o) => o.getAttribute("aria-checked") === "true");
    const step = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
    if (!step) return;
    e.preventDefault();
    pick(options[(i + step + options.length) % options.length]!, true);
  });
</script>

<style>
  .glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 10%;
    height: 70%;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 50% at 70% 50%, rgba(201, 242, 77, 0.06), transparent 70%);
  }
  .byo { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 4vw, 56px); align-items: start; }

  .options { display: grid; gap: 8px; }
  .opt {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 13px 14px;
    border-radius: var(--r);
    background: var(--raised);
    border: 1px solid var(--line);
    text-align: left;
    transition: background 0.2s, border-color 0.2s, transform 0.2s var(--ease);
  }
  .opt:hover { background: var(--raised-2); border-color: var(--line-strong); }
  .opt[aria-checked="true"] { border-color: var(--accent-line); background: #1b1f18; box-shadow: 0 0 0 3px rgba(201, 242, 77, 0.07); }
  .ico { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: var(--sunken); border: 1px solid var(--line); color: var(--text-2); }
  .opt[aria-checked="true"] .ico { color: var(--accent); }
  .ico svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .n { font-weight: 600; font-size: 15.5px; }
  .p { color: var(--text-3); font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .opt .chip { font-size: 11px; }

  .preview {
    position: sticky;
    top: 96px;
    padding: clamp(18px, 2.5vw, 28px);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, #16191d, #121417);
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4);
    display: grid;
    gap: 14px;
  }
  .status { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); transition: background 0.3s, box-shadow 0.3s; }
  .dot.off { background: var(--text-3); box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.05); }

  .composer { border-radius: 16px; background: var(--raised); border: 1px solid var(--accent-line); box-shadow: 0 0 0 3px rgba(201, 242, 77, 0.06); padding: 12px; display: grid; gap: 10px; }
  .quote { font: 14.5px/1.55 var(--font-paper); color: var(--text); background: var(--sunken); border-radius: 10px; border-left: 3px solid var(--accent); padding: 10px 14px; display: grid; gap: 4px; }
  .src { display: inline-flex; align-items: center; gap: 6px; font: 12px var(--font-ui); color: var(--text-3); }
  .src svg, .c svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .ph { color: var(--text-3); font-size: 14px; padding: 4px 4px 10px; }
  .chips { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .c { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; background: var(--sunken); border: 1px solid var(--line); font-size: 13px; white-space: nowrap; }
  .c[hidden] { display: none; }
  .c i { font-style: normal; color: var(--text-3); }
  .c b { font-weight: 500; }
  .c .chev { color: var(--text-3); width: 11px; height: 11px; }
  .send { margin-left: auto; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: var(--accent-fg); display: grid; place-items: center; }
  .send svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .chips:global(.swap) .c { animation: swap 0.45s var(--ease) both; }
  .chips:global(.swap) .c:nth-child(2) { animation-delay: 0.05s; }
  .chips:global(.swap) .c:nth-child(3) { animation-delay: 0.1s; }
  @keyframes swap {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .signin { font-size: 14px; color: var(--text-2); min-height: 2.9em; padding-inline: 2px; }

  .flow { list-style: none; margin: 6px 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; counter-reset: f; }
  .flow li { position: relative; display: grid; gap: 3px; padding: 12px; border-radius: 12px; background: var(--sunken); border: 1px solid var(--line); }
  .flow li:not(:last-child)::after { content: "→"; position: absolute; right: -10px; top: 50%; transform: translate(50%, -50%); color: var(--accent); font-size: 14px; z-index: 1; }
  .flow b { font-size: 13.5px; font-weight: 600; }
  .flow span { font-size: 12.5px; color: var(--text-3); }
  .fine { font-size: 13px; color: var(--text-3); }

  @media (max-width: 960px) {
    .byo { grid-template-columns: minmax(0, 1fr); }
    .preview { position: relative; top: 0; }
  }
  @media (max-width: 520px) {
    .flow { grid-template-columns: minmax(0, 1fr); }
    .flow li:not(:last-child)::after { content: "↓"; right: 50%; top: auto; bottom: -10px; transform: translate(50%, 50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .chips:global(.swap) .c { animation: none; }
  }
</style>
