# Response headers for the static assets (Cloudflare Workers reads this file; it isn't served).
# Files under /_astro/ are named by a hash of their contents, so they never change at a given URL: browsers can
# keep them for a year without asking again. Everything else keeps Cloudflare's default (revalidate each time).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
