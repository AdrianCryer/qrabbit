{
  "name": "qrabbit",
  "private": true,
  "version": "0.0.0",
  "description": "Read difficult material with AI: highlight, explore in branches, keep what you learned.",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "spike:acp": "pnpm --filter @qrabbit/spike-acp run start",
    "desktop:build": "pnpm --filter @qrabbit/desktop run build",
    "desktop:dev": "pnpm --filter @qrabbit/desktop run dev",
    "desktop:drive": "node tools/dev/drive-desktop.mjs",
    "site:dev": "pnpm --filter @qrabbit/site run dev",
    "site:build": "pnpm --filter @qrabbit/site run build",
    "cloud:start": "pnpm --filter @qrabbit/cloud run start",
    "cloud:stop": "pnpm --filter @qrabbit/cloud run stop",
    "cloud:status": "pnpm --filter @qrabbit/cloud run status",
    "cloud:reset": "pnpm --filter @qrabbit/cloud run reset",
    "cloud:types": "pnpm --filter @qrabbit/cloud run types",
    "cloud:test": "pnpm --filter @qrabbit/cloud run test"
  },
  "engines": { "node": ">=22" }
}
